// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// SQLite doesn't support Prisma's `enum` or `Decimal` types, so this schema
// intentionally avoids both (String columns + zod validation in the app
// layer instead) to stay portable to Postgres in production without a
// rewrite. See /Users/mikko/.claude/plans/smooth-crafting-rose.md.

model Admin {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  themePreference      String    @default("light")
  // `previousLoginAt` is the value `lastLoginAt` held right before the
  // current session's login overwrote it — this is the cursor the "depuis
  // votre dernière connexion" dashboard panel actually compares against,
  // since by the time the dashboard renders, `lastLoginAt` is already "now".
  lastLoginAt          DateTime?
  previousLoginAt      DateTime?
  // Boîte mail Gmail intégrée à l'admin (voir src/lib/gmail.ts) — un seul
  // compte Google connecté, celui de l'admin, d'où ces champs directement
  // sur `Admin` plutôt qu'une table à part. `gmailRefreshTokenEnc` est
  // chiffré (src/lib/crypto-secrets.ts), jamais stocké en clair : ce token
  // donne un accès permanent en lecture/envoi au Gmail personnel de
  // l'admin, une fuite de la base ne doit pas suffire à elle seule à
  // l'exploiter.
  gmailEmail           String?
  gmailRefreshTokenEnc String?
  gmailConnectedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  uploadedDocuments Document[]
  timeEntries       TaskTimeEntry[]
}

model Client {
  id           String   @id @default(cuid())
  name         String
  // Raison sociale — le nom légal de l'entité (ex. "SASU SAJJ"), distinct
  // du nom commercial/de scène utilisé partout ailleurs dans l'app (ex.
  // "QG Club"). Ajouté le 2026-07-31, nullable : la catégorie "Particulier"
  // n'a pas de raison sociale, et les clients existants n'en ont pas.
  raisonSociale String?
  notes        String?
  address      String?
  siret        String?
  vatNumber    String?
  // Adresse utilisée pour l'envoi manuel des documents (factures/devis...)
  // depuis la fiche client — distincte des emails des comptes de connexion.
  billingEmail String?
  // Lien vers le dossier Google Drive du client, affiché dans le bandeau de
  // l'espace client. Un seul lien par client (pas par compte).
  driveUrl     String?
  // Espace client public accessible sans connexion (bouton "Voir l'espace
  // client de démo" côté site vitrine) — voir src/lib/actions/demo.ts. Un
  // seul client devrait porter ce flag ; les Server Actions d'écriture
  // côté client le vérifient (assertNotDemo dans src/lib/dal.ts) pour
  // rester en lecture seule malgré l'accès public.
  isDemo       Boolean  @default(false)
  // Catégorie du client (Club, Marque, Artiste...) — liste ouverte gérée
  // depuis /admin/listes comme les autres (`client_category`), donc un
  // `DropdownItem` plutôt qu'une colonne texte : on récupère gratuitement le
  // badge coloré, l'ordre d'affichage et l'édition sans migration. Nullable :
  // un client peut rester non catégorisé, et `onDelete: SetNull` évite qu'une
  // suppression de catégorie emporte des clients avec elle.
  categoryId   String?
  category     DropdownItem? @relation("ClientCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  // Avatar du client (logo ou photo), affiché en rond dans la liste
  // `/admin/clients` et sur sa fiche. Même trio de colonnes que
  // `HomepageHero`/`PortfolioPillar` : la clé de stockage, le type MIME (pour
  // servir le fichier) et le backend d'origine, servi par
  // `/api/clients/[clientId]/avatar`.
  avatarStorageKey     String?
  avatarMimeType       String?
  avatarStorageBackend String?
  // Client archivé (ancien client) : sorti des listes et sélecteurs de
  // travail, mais **rien n'est détruit** — c'est l'alternative réversible à
  // `deleteClient`, qui supprime en cascade tâches, documents et livrables.
  // Reste volontairement compté dans les Finances et les exports : archiver
  // un client ne doit pas réécrire l'historique comptable ni amputer une
  // sauvegarde. Voir `ACTIVE_CLIENTS` (src/lib/clients.ts).
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Renommé "users" -> "contacts" le 2026-07-31 (split Contact/ClientContact,
  // voir plus bas) — ce sont les rattachements de contacts à ce client, pas
  // des comptes utilisateurs au sens propre.
  contacts       ClientContact[]
  tasks          Task[]
  documents      Document[]
  paymentRecords PaymentRecord[]
  // Nommé différemment du champ `notes` (texte libre juste au-dessus) —
  // celui-ci est la relation vers le module de notes internes (Note[]).
  linkedNotes    Note[]
  // Renseigné uniquement quand ce client vient de la conversion d'un
  // prospect (bouton "Convertir en client" sur /admin/prospection) — voir
  // Prospect.convertedClient ci-dessous.
  prospectOrigin Prospect?
}

// Identité d'un contact — carnet d'adresses partageable (ajouté le
// 2026-07-31, demande explicite : "un contact peut être dans plusieurs
// fiches clients"). Avant cette date, `ClientUser` confondait l'identité
// (nom/email/téléphone/fonction) et le compte d'accès à l'espace client
// dans un seul modèle attaché à un seul client — un même contact ne
// pouvait donc pas être rattaché à deux clients sans dupliquer sa fiche.
// `Contact` porte maintenant l'identité seule ; `ClientContact` (ci-dessous)
// porte le rattachement à un client donné et son éventuel accès.
model Contact {
  id        String   @id @default(cuid())
  name      String
  // Unique : c'est ce qui permet de retrouver et réaffecter un contact déjà
  // saisi ("Affecter un contact existant" plutôt que "Nouveau") plutôt que
  // d'en créer un doublon. Nullable : un contact peut n'avoir qu'un
  // téléphone (Postgres autorise plusieurs NULL sur un index unique).
  email     String?  @unique
  phone     String?
  // Fonction du contact (ex. "Directeur", "DJ", "Photographe") — texte
  // libre, pas de liste fermée (trop variable d'un client à l'autre, et
  // peut différer d'un client à l'autre pour la même personne — mais reste
  // ici, pas sur ClientContact, par simplicité : le cas d'une fonction
  // différente selon le client est resté hors scope de cette évolution).
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientLinks ClientContact[]
}

// Rattachement d'un `Contact` à un `Client`, et l'éventuel compte d'accès à
// l'espace client qui va avec — l'accès reste "par client" (demande
// explicite) : le même contact peut avoir un accès ouvert chez un client et
// aucun chez un autre, avec des mots de passe indépendants. Remplace
// l'ancien `ClientUser` : mêmes champs de compte, identité désormais lue
// via `contact`. Les anciens id `ClientUser` sont conservés tels quels sur
// cette table lors de la migration (voir
// 20260731_split_contact_from_client_user/migration.sql) — Task.createdById,
// TaskComment.authorId, Session.subjectId, PasswordResetToken.subjectId et
// AuditLogEntry.targetId, qui référencent cet id en chaîne libre (pas de
// FK), restent donc valides sans aucune réécriture.
model ClientContact {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String
  contact  Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // Nullable : `null` = aucun mot de passe défini. Ce n'est PAS
  // l'interrupteur d'accès (voir `portalAccessEnabled`) — un contact
  // fraîchement invité a un accès ouvert et un `passwordHash` encore nul
  // tant qu'il n'a pas suivi son lien d'invitation.
  passwordHash              String?
  // Interrupteur d'accès à l'espace client, décorrélé de l'existence d'un mot
  // de passe pour pouvoir couper l'accès sans détruire le compte (et le
  // rouvrir sans refaire une invitation). `false` par défaut : un contact
  // rattaché depuis le carnet d'adresses n'ouvre pas un espace client par
  // accident, l'admin le décide explicitement.
  portalAccessEnabled       Boolean   @default(false)
  // Interrupteur par profil (bouton sur la fiche client, section "Comptes de
  // connexion") pour autoriser les emails automatiques (nouvelle tâche à
  // valider, rappel d'échéance, nouveau livrable/document, relance de
  // paiement, BAT validé) — désactivé par défaut (opt-in) pour éviter de
  // spammer un profil par erreur, l'admin l'active explicitement pour le(s)
  // contact(s) qui doivent être notifiés. N'affecte jamais l'email de
  // réinitialisation de mot de passe (sécurité, pas une notification).
  emailNotificationsEnabled Boolean   @default(false)
  themePreference           String    @default("light")
  lastLoginAt               DateTime?
  // Visite guidée affichée au tout premier login (voir
  // `FirstLoginTour`) — passe à `true` dès qu'elle est terminée ou passée,
  // pour ne plus jamais la réafficher ensuite.
  hasSeenTour               Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  loginEvents ClientLoginEvent[]

  // Un contact ne peut être rattaché qu'une seule fois au même client — pas
  // de doublon du même lien.
  @@unique([clientId, contactId])
}

// Historique des connexions client, pour le "journal de connexion" du
// tableau de bord admin — distinct de `ClientContact.lastLoginAt` (qui ne
// garde que la toute dernière connexion) : une ligne par connexion réussie.
model ClientLoginEvent {
  id              String        @id @default(cuid())
  clientContactId String
  clientContact   ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  loggedInAt      DateTime      @default(now())
}

// Opaque session tokens: subjectType/subjectId is a lightweight polymorphic
// reference (Admin or ClientUser) rather than two nullable FKs, since a
// session belongs to exactly one subject type at a time.
model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  subjectType String
  subjectId   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  subjectType String
  subjectId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String?
  succeeded  Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

// Limite la fréquence des demandes de réinitialisation de mot de passe
// (voir requestReset dans src/lib/actions/password-reset.ts) — sans ça,
// ce formulaire public peut être utilisé pour spammer n'importe quelle
// adresse email de rappels "mot de passe oublié".
model PasswordResetAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model DropdownList {
  id               String         @id @default(cuid())
  key              String         @unique
  name             String
  allowCustomItems Boolean        @default(true)
  items            DropdownItem[]
}

// `slug` is the stable key application code branches on (never edited);
// `label`/`color`/`sortOrder` are freely admin-editable. `locked` prevents
// adding/removing items on lists whose membership is fixed by the cahier
// des charges (the six task statuses, and the "facture" document type).
model DropdownItem {
  id        String       @id @default(cuid())
  listId    String
  list      DropdownList @relation(fields: [listId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  color     String
  sortOrder Int          @default(0)
  locked    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tasks     Task[]
  documents Document[]
  prospects Prospect[]
  clients   Client[] @relation("ClientCategory")

  taskTypeOf   Task[] @relation("TaskTypes")
  taskFormatOf Task[] @relation("TaskFormats")

  @@unique([listId, slug])
}

model Task {
  id                 String       @id @default(cuid())
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  statusId           String
  status             DropdownItem @relation(fields: [statusId], references: [id])
  eventDate          DateTime?
  dueDate            DateTime?
  createdByType      String
  createdById        String
  refusalReason      String?
  refusedAt          DateTime?
  batValidatedAt     DateTime?
  archivedAt         DateTime?
  lastReminderAt     DateTime?
  // Épinglage admin (bouton une pastille, `toggleTaskPin`) — non null =
  // épinglée, la date sert aussi à trier la liste des tâches épinglées du
  // tableau de bord (plus récemment épinglée en premier). Remis à `null`
  // automatiquement quand la tâche passe au statut "Terminé"
  // (`setTaskStatus`), même pattern que `archivedAt`/`refusedAt`.
  pinnedAt           DateTime?
  // Date du dernier envoi groupé des livrables finaux par email (bouton
  // "Envoyer les livrables finaux" — voir `sendDeliverablesByEmail`), même
  // logique que `Document.sentAt` : un indicateur envoyé/non envoyé, pas un
  // accusé de réception.
  deliverablesSentAt DateTime?
  // Temps estimé pour la tâche, en minutes — saisi par l'admin, comparé au
  // temps réellement passé (`TaskTimeEntry`) pour la jauge colorée de
  // `/admin/taches`. Jamais exposé côté espace client (suivi interne
  // uniquement).
  estimatedMinutes   Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  types   DropdownItem[] @relation("TaskTypes")
  formats DropdownItem[] @relation("TaskFormats")

  deliverables   Deliverable[]
  attachments    Attachment[]
  comments       TaskComment[]
  refusalHistory TaskRefusalHistory[]
  statusHistory  TaskStatusHistory[]
  timeEntries    TaskTimeEntry[]
  checklistItems TaskChecklistItem[]
}

// Fiche de prospection (CRM léger, /admin/prospection). `statusId` pointe
// vers la liste verrouillée "prospect_status" (5 valeurs, même pattern que
// les statuts de tâche). `source` distingue une saisie manuelle d'un ajout
// par la recherche assistée par IA (voir src/lib/prospect-search.ts).
// `nextReminderAt`/`reminderSentAt` suivent le même pattern que
// Note.reminderAt/reminderSentAt : remis à null dès que la date change,
// pour ne jamais rater ou dupliquer une alerte planifiée
// (src/lib/prospect-reminders.ts, cron quotidien).
model Prospect {
  id        String       @id @default(cuid())
  name      String
  company   String?
  address   String?
  phone     String?
  email     String?
  instagram String?
  website   String?
  notes     String?
  statusId  String
  status    DropdownItem @relation(fields: [statusId], references: [id])
  source    String       @default("manuel")

  nextReminderAt DateTime?
  reminderSentAt DateTime?

  // Renseignés une fois converti en client via convertProspectToClient —
  // le prospect n'est jamais supprimé à la conversion, juste marqué "fermé"
  // et relié au nouveau Client.
  convertedClientId String?   @unique
  convertedClient   Client?   @relation(fields: [convertedClientId], references: [id])
  convertedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity ProspectActivity[]
  // Nommé différemment du champ `notes` (texte libre juste au-dessus) —
  // celui-ci est la relation vers le module de notes internes, même
  // convention que `Client.linkedNotes`.
  linkedNotes Note[]
}

// Mini fil d'historique par prospect (créé, changement de statut, email
// envoyé, relance) — même esprit que TaskStatusHistory : une ligne par
// évènement, jamais réécrite ni supprimée, message dénormalisé (lisible même
// si le contexte change ensuite). Affiché en ordre chronologique inverse sur
// la fiche prospect.
model ProspectActivity {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String
  message    String
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

// Sous-étapes cochables d'une tâche (ex. "logo reçu", "brief validé") —
// suivi interne admin uniquement, jamais exposé côté espace client. Même
// esprit que les checklists du module Notes, mais rattachées à une tâche
// plutôt qu'à une note libre.
model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Suivi du temps passé sur une tâche (chronomètre visible dans le header
// admin) — une ligne par session. `endedAt` null = session en cours ; un
// seul admin existe dans ce projet, donc au plus une ligne `endedAt: null`
// à la fois dans toute la table (imposé par `startTaskTimer`, qui arrête
// systématiquement la session en cours avant d'en démarrer une nouvelle,
// sur n'importe quelle tâche). `manual` distingue les sessions ajoutées à
// la main (correction, oubli de lancer le chrono) des sessions
// effectivement chronométrées — mêmes champs `startedAt`/`endedAt` dans les
// deux cas pour garder un calcul de durée uniforme. Jamais exposé côté
// espace client.
model TaskTimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  manual    Boolean   @default(false)
  createdAt DateTime  @default(now())
  // Admin qui a démarré ce chrono — nullable pour ne pas casser l'historique
  // pré-multi-admin (2026-07-29). Un chrono actif (`endedAt: null`) est
  // maintenant par admin, pas global : voir `startTaskTimer`.
  startedByAdminId String?
  startedByAdmin   Admin?  @relation(fields: [startedByAdminId], references: [id], onDelete: SetNull)
}

// Audit trail des changements de statut d'une tâche (qui, quand, vers quel
// statut) — couvre aussi bien les changements admin (`setTaskStatus`) que
// les actions client (`validateTask`/`refuseTask`), plus la création de la
// tâche (statut initial "Nouveau"). `statusLabel` est dénormalisé (même
// raisonnement que `TaskComment.authorName`) pour rester lisible même si le
// libellé du statut est renommé plus tard depuis `/admin/listes`.
model TaskStatusHistory {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  statusSlug    String
  statusLabel   String
  changedByType String
  changedById   String
  changedByName String
  changedAt     DateTime @default(now())
}

// Historique des refus de BAT, pour ne pas perdre le motif quand le BAT est
// ensuite validé : `Task.refusalReason`/`refusedAt` ne gardent que le refus
// courant et sont remis à `null` par `setTaskStatus`/`validateTask` au
// passage en "BAT validé" (même pattern que `ClientLoginEvent` pour
// `ClientUser.lastLoginAt` — une ligne par évènement, jamais réécrite ni
// supprimée).
model TaskRefusalHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reason    String
  refusedAt DateTime
  createdAt DateTime @default(now())
}

// Fil de commentaires par tâche (admin + client), pour discuter d'une tâche
// sans passer par email. `authorType`/`authorName` sont dénormalisés (comme
// `createdByType`/`createdById` sur Task) pour garder l'historique lisible
// même si le compte auteur est supprimé plus tard.
model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorType String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())
}

model Deliverable {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  storageBackend String
  // "bat" (épreuve à valider, filigranée côté client si l'option est
  // active — voir src/lib/watermark.ts) ou "final" (livrable remis, jamais
  // filigrané). Les lignes existantes migrent en "final" par défaut : rien
  // n'est filigrané rétroactivement sans action de l'admin.
  kind           String   @default("final")
  uploadedAt     DateTime @default(now())
}

// Fichiers de référence fournis par le client à la création d'une tâche
// (moodboard, briefing, logo...) — distinct de `Deliverable` (le travail fini
// livré par Mikko) pour ne pas polluer l'onglet "Livrables" du client.
model Attachment {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  storageBackend String
  uploadedAt     DateTime @default(now())
}

model Document {
  id                      String       @id @default(cuid())
  clientId                String
  client                  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  typeId                  String
  type                    DropdownItem @relation(fields: [typeId], references: [id])
  fileName                String
  storageKey              String
  mimeType                String
  sizeBytes               Int
  storageBackend          String
  amountCents             Int?
  currency                String       @default("EUR")
  paymentStatus           String       @default("n/a")
  stripeCheckoutSessionId String?
  paidAt                  DateTime?
  dueDate                 DateTime?
  lastReminderAt          DateTime?
  // Date du dernier envoi manuel du document par email (bouton "Envoyer le
  // document" sur la fiche client / la liste des documents) — sert
  // uniquement d'indicateur "envoyé/non envoyé", pas un accusé de réception.
  sentAt                  DateTime?
  // Nullable + SetNull (multi-admin, 2026-07-29) : révoquer un compte admin
  // (voir `revokeAdmin`) ne doit jamais échouer parce qu'il a uploadé des
  // documents par le passé — l'historique du document reste intact, juste
  // sans auteur retrouvable.
  uploadedByAdminId       String?
  uploadedByAdmin         Admin?       @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
  uploadedAt              DateTime     @default(now())
  // Signature client sur un devis (type.slug === "devis" uniquement) —
  // signature légère, pas une valeur légale certifiée : nom tapé + dessin à
  // l'écran + horodatage + IP, suffisant pour accélérer le cycle devis →
  // accord. `acceptedAt` sert aussi de garde anti-re-signature.
  acceptedAt              DateTime?
  acceptedByName          String?
  signatureDataUrl        String?      @db.Text
  acceptedFromIp          String?
  // Rattachement d'une facture à un mois précis pour le rapport Temps &
  // rentabilité (demande du 2026-07-31) — distinct de `uploadedAt` : un
  // client facturé au forfait mensuel doit compter sur le mois convenu, pas
  // sur la date à laquelle la facture a été chargée dans l'app, qui peut
  // décaler de plusieurs jours. Uniquement pertinent quand
  // `isMonthlyInvoice` est vrai ; les clients facturés à la tâche laissent
  // les trois champs à leur valeur par défaut et continuent d'utiliser
  // `uploadedAt` comme avant.
  isMonthlyInvoice        Boolean      @default(false)
  invoiceYear             Int?
  invoiceMonth            Int?
}

// Document interne sans client associé (Commercial / Société) — brochures,
// plaquettes, K-bis, statuts... Volontairement séparé de `Document` plutôt
// qu'un `clientId` rendu nullable dessus : `Document` est utilisé partout
// (facturation, exports, purge, Finances) en présumant un client, et
// blurrer cette garantie pour deux catégories qui n'ont explicitement "pas
// d'affectation" (demande du 2026-07-31) aurait forcé à revérifier chacun
// de ces usages. Consultation/téléchargement/suppression uniquement, pas
// de montant ni de statut de paiement.
model CompanyDocument {
  id                String   @id @default(cuid())
  // "commercial" | "societe" — voir COMPANY_DOCUMENT_CATEGORY
  // (src/lib/dropdown-lists.ts). Catégories fixes, pas une DropdownList :
  // structurelles, pas une liste que l'admin doit pouvoir renommer/colorer.
  category          String
  fileName          String
  storageKey        String
  mimeType          String
  sizeBytes         Int
  storageBackend    String
  uploadedAt        DateTime @default(now())
}

// Suivi d'un paiement sans document de facture associé (acompte reçu par
// virement, règlement en espèces...) — demande du 2026-07-31. Distinct de
// `Document` : aucun fichier n'est nécessairement lié, juste un montant et
// un statut à cocher.
model PaymentRecord {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label         String?
  amountCents   Int
  currency      String    @default("EUR")
  paymentStatus String    @default("unpaid")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
}

// Image insérée dans une note (ajouté le 2026-07-31) — pas de relation vers
// `Note` : une note peut contenir plusieurs images et en perdre au fil de
// l'édition de son HTML, un lien 1-N figé n'aurait pas de sens. Chaque ligne
// existe uniquement pour donner une route de service stable
// (`/api/fichiers/notes-images/[id]`) à l'`<img>` inséré dans le contenu.
// Connu et accepté : si une image est retirée du texte, le fichier reste en
// stockage (pas de purge automatique) — même compromis que d'autres médias
// intégrés en ligne dans ce projet.
model NoteImage {
  id             String   @id @default(cuid())
  storageKey     String
  mimeType       String
  sizeBytes      Int
  storageBackend String
  createdAt      DateTime @default(now())
}

// Singleton (toujours id "settings") pour les réglages ajustables en direct
// depuis /admin/reglages, sans redéploiement. Même pattern que
// HomepageContent/HomepageHero ci-dessous.
model AppSettings {
  id                          String   @id @default("settings")
  // Nombre de jours après lesquels un livrable final (tâche "Terminé")
  // est purgé du stockage — voir /api/cron/purge-livrables.
  deliverableRetentionDays    Int      @default(60)
  // Filigrane à 10% d'opacité appliqué à la volée aux BAT (Deliverable.kind
  // = "bat") vus par le client — voir src/lib/watermark.ts.
  batWatermarkEnabled         Boolean  @default(true)
  popupEnabled                Boolean  @default(false)
  popupMessage                String?
  // Délai (en jours) utilisé uniquement pour préremplir la date de relance
  // suggérée à la création d'un prospect (/admin/prospection/nouveau) — pas
  // une automatisation cachée, le champ reste éditable ou vidable.
  prospectReminderDefaultDays Int      @default(14)
  updatedAt                   DateTime @updatedAt
}

model EmailLog {
  id             String   @id @default(cuid())
  triggerType    String
  recipientEmail String
  sentAt         DateTime @default(now())
  success        Boolean
  error          String?
}

// Each cover/item resolves its image either from an external URL (the
// Picsum placeholders migrated from the original static content) or from an
// uploaded file via StorageAdapter — never both. See
// src/lib/portfolio-media.ts for the resolver. Portfolio media is public
// (no auth), unlike client Documents/Deliverables.
model PortfolioPillar {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  description         String
  sortOrder           Int      @default(0)
  mediaType           String   @default("mixed")
  coverExternalUrl    String?
  coverStorageKey     String?
  coverMimeType       String?
  coverStorageBackend String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items PortfolioMediaItem[]
}

// aspectRatio is "3:4" or "9:16" (client uploads photos in one of these two
// crops, videos are always "9:16" - enforced in src/lib/actions/portfolio.ts,
// not just this default). Controls the CSS tile shape on the public grid.
model PortfolioMediaItem {
  id             String          @id @default(cuid())
  pillarId       String
  pillar         PortfolioPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  title          String
  mediaType      String
  aspectRatio    String          @default("3:4")
  externalUrl    String?
  storageKey     String?
  mimeType       String?
  storageBackend String?
  sizeBytes      Int?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
}

// Singleton (always id "hero") holding the two images in the homepage Hero
// section (src/components/hero-visual.tsx), below the "Voir le travail"
// button. No externalUrl fields here (unlike PortfolioPillar/MediaItem) —
// there's no legacy data to migrate, the component falls back to its
// original hardcoded Picsum placeholders in code when a slot is empty. See
// src/lib/homepage-hero.ts for the resolver.
model HomepageHero {
  id                   String   @id @default("hero")
  mainStorageKey       String?
  mainMimeType         String?
  mainStorageBackend   String?
  detailStorageKey     String?
  detailMimeType       String?
  detailStorageBackend String?
  updatedAt            DateTime @updatedAt
}

// Singleton (always id "homepage") holding editable copy for the homepage
// Hero and portfolio section headings. Fields are nullable — an empty value
// falls back to the original hardcoded copy in code, same pattern as
// HomepageHero images. See src/lib/homepage-content.ts for the resolver.
model HomepageContent {
  id                String   @id @default("homepage")
  heroTitle         String?
  heroSubtitle      String?
  heroButtonLabel   String?
  portfolioTitle    String?
  portfolioSubtitle String?
  updatedAt         DateTime @updatedAt
}

// Module de notes internes ("Notes" dans le nav admin), pensé pour se
// comporter comme Apple Notes : dossiers + épinglage, pas de lien avec
// l'espace client (aucune vue client n'expose ces modèles).
model NoteFolder {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes Note[]
}

model Note {
  id             String      @id @default(cuid())
  title          String      @default("")
  // HTML produit par l'éditeur Tiptap (voir src/components/admin/note-editor.tsx).
  content        String      @default("") @db.Text
  pinned         Boolean     @default(false)
  folderId       String?
  folder         NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Rattachement optionnel à un client — reste interne à l'admin, jamais
  // exposé côté espace client.
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Rattachement optionnel à un prospect (ajouté le 2026-07-31, même esprit
  // que `clientId` ci-dessus) — une note ne peut se rattacher qu'à l'un OU
  // l'autre, jamais les deux (voir la validation dans `createNote`/
  // `updateNote`), un prospect converti devient un client via
  // `convertProspectToClient`, pas les deux à la fois.
  prospectId     String?
  prospect       Prospect?   @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  // Rappel façon pense-bête (ex. "me rappeler ça le 12/08") — une date, pas
  // une heure précise. `reminderSentAt` évite qu'un cron quotidien
  // (src/app/api/cron/note-reminders) renvoie le même rappel plusieurs fois ;
  // remis à `null` si la date est modifiée (voir updateNote), pour que
  // décaler un rappel déjà envoyé le renvoie normalement à la nouvelle date.
  reminderAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([folderId])
  @@index([clientId])
  @@index([prospectId])
}

// Journal d'audit global — actions sensibles uniquement (connexions,
// suppressions définitives, changements/réinitialisations de mot de passe,
// exports de données, usurpation d'espace client), pas une trace de toute
// modification (voir /admin/audit). `actorLabel`/`targetLabel` sont
// dénormalisés pour rester lisibles même si le compte/l'entité visée est
// supprimé ensuite (même raisonnement que `TaskComment.authorName`).
model AuditLogEntry {
  id          String   @id @default(cuid())
  actorType   String // "ADMIN" | "SYSTEM"
  actorId     String?
  actorLabel  String
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  metadata    String? @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
