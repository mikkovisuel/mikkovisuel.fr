# Copiez ce fichier en .env et remplissez les valeurs.

# Dev local : "file:./dev.db". Prod : chaîne de connexion Postgres.
DATABASE_URL="file:./dev.db"

# Compte admin unique, créé par prisma/seed.ts (aucune route d'inscription
# n'existe dans le code).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Services externes, optionnels en développement ---
# Absents = fonctionnalités dégradées proprement :
# pas de STRIPE_SECRET_KEY -> bouton de paiement masqué
# pas de RESEND_API_KEY -> emails loggés dans la console au lieu d'être envoyés
# pas de variables S3 -> stockage sur disque local (./storage), à ne jamais
# utiliser en production (disque éphémère sur Scalingo)

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION=""
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
