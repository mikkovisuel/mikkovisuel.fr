# Copiez ce fichier en .env et remplissez les valeurs.

# Dev local : "file:./dev.db". Prod : chaîne de connexion Postgres.
DATABASE_URL="file:./dev.db"

# Compte admin unique, créé par prisma/seed.ts (aucune route d'inscription
# n'existe dans le code).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Services externes, optionnels en développement ---
# Absents = fonctionnalités dégradées proprement :
# pas de STRIPE_SECRET_KEY -> bouton de paiement masqué
# pas de RESEND_API_KEY -> emails loggés dans la console au lieu d'être envoyés
# pas de variables S3 -> stockage sur disque local (./storage), à ne jamais
# utiliser en production (disque éphémère sur Scalingo)
# pas de ANTHROPIC_API_KEY -> bouton "Rechercher des prospects (IA)" masqué
# sur /admin/prospection (voir GUIDE_PROSPECTION_IA.md)

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Deuxième moyen de paiement en ligne, en plus de Stripe (pas à la place) —
# absents = bouton "Payer avec PayPal" masqué proprement. Identifiants d'une
# app PayPal Developer (sandbox pour tester, live en production).
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "live" pour taper l'API de production PayPal — toute autre valeur (ou
# absente) reste sur l'API sandbox, par sécurité en développement.
PAYPAL_MODE=""
RESEND_API_KEY=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION=""
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
ANTHROPIC_API_KEY=""
# Optionnel — par défaut "claude-sonnet-5" si absent.
ANTHROPIC_MODEL=""

# --- Variables techniques internes ---
# URL publique du site, utilisée pour construire les liens dans les emails
# (réinitialisation de mot de passe, invitation contact, rappel de paiement,
# invitation admin...) — défaut http://localhost:3000 si absente.
# IMPORTANT en production : utiliser https://www.mikkovisuel.fr, PAS
# https://mikkovisuel.fr (sans www) — le domaine nu renvoie une 403 (souci
# DNS/hébergement côté OVH, constaté le 2026-07-20, jamais résolu). Une
# valeur en domaine nu casse silencieusement tous les liens envoyés par
# email (repéré le 2026-08-01 via une invitation contact qui n'ouvrait pas).
NEXT_PUBLIC_SITE_URL=""
# Secret partagé pour authentifier les tâches planifiées Scalingo (voir
# cron.json et src/app/api/cron/*/route.ts) — génération manuelle, ex.
# `openssl rand -hex 32`. Les routes cron répondent 503 si absent (échec
# fermé, jamais une purge/relance non protégée).
CRON_SECRET=""
# Clé de chiffrement du refresh token Gmail stocké en base
# (src/lib/crypto-secrets.ts, AES-256-GCM) — génération manuelle, ex.
# `openssl rand -hex 32`. Distincte des mots de passe (hashés, pas chiffrés).
ENCRYPTION_KEY=""
# Identifiants OAuth Google pour la boîte mail Gmail intégrée à l'admin
# (voir GUIDE_GMAIL.md) — absents = bouton "Connecter Gmail" reste
# fonctionnel mais la connexion échouera proprement.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Doit correspondre exactement à un URI de redirection autorisé sur le
# client OAuth Google — différent en local et en production (voir
# GUIDE_GMAIL.md).
GOOGLE_REDIRECT_URI=""
